@model IEnumerable<FoodOrdering.Web.Models.FoodItem>

@{
    ViewData["Title"] = "Foods";
}

<h2 class="mb-4">Browse Foods</h2>

<form asp-controller="Food" asp-action="Index" method="get" class="mb-4 d-flex">
    <input type="text"
           name="search"
           value="@ViewBag.Search"
           class="form-control me-2"
           placeholder="Search food..." />

    <button type="submit" class="btn btn-warning">Search</button>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card food-item-card shadow">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" />
                }

                <div class="card-body">
                    <h5>@item.Name</h5>
                    <p>@item.Description</p>
                    <p><b>Category:</b> @item.Category?.Name</p>
                    <p class="food-price">₹@item.Price</p>

                    <a asp-controller="Cart"
                           asp-action="AddToCart"
                           asp-route-id="@item.Id"
                           class="btn btn-success">
                        Add to Cart
                    </a>

                    <a asp-controller="Food"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary">
                        Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>