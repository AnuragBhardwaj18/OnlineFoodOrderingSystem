@model FoodOrdering.Web.Models.FoodItem

@{
    ViewData["Title"] = "Food Details";
}

<div class="card shadow p-4">
    <div class="row">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded" />
            }
        </div>

        <div class="col-md-7">
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>
            <p><b>Category:</b> @Model.Category?.Name</p>
            <h3 class="text-warning">₹@Model.Price</h3>

            <a asp-controller="Cart"
                   asp-action="AddToCart"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">
                Add to Cart
            </a>
        </div>
    </div>
</div>